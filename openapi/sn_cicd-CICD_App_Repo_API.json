      "post": {
        "description": "Rollback an application to prior version",
        "parameters": [
          {
            "name": "sys_id",
            "in": "query",
            "description": "The unique sys_id of the application (sys_id or scope required)",
            "required": false,
            "schema": {}
          },
          {
            "name": "scope",
            "in": "query",
            "description": "The scope of the application",
            "required": false,
            "schema": {}
          },
          {
            "name": "version",
            "in": "query",
            "description": "The expected version after rollback",
            "required": true,
            "schema": {}
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {},
            "application/xml": {},
            "text/xml": {}
          }
        },
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {},
              "application/xml": {},
              "text/xml": {}
            }
